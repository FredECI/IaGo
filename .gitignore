# Configuração do Firebase (gerada localmente; nunca versionar).
/env/*.json
!/env/*.example.json
/lib/firebase_options.dart
/android/app/google-services.json
/.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
